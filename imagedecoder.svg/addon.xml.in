<?xml version="1.0" encoding="UTF-8"?>
<addon
  id="imagedecoder.svg"
  version="1.1.0"
  name="SVG image decoder"
  provider-name="cinemaONE">
  <requires>@ADDON_DEPENDS@</requires>
  <extension
    point="kodi.imagedecoder"
    library_@PLATFORM@="@LIBRARY_FILENAME@">
    <support>
      <mimetype name="image/svg+xml">
        <extension>.svg</extension>
        <description>Scalable Vector Graphics</description>
      </mimetype>
      <!-- Non-standard, but Kodi's texture loader derives the mimetype as
           "image/" + extension for a plain <texture>foo.svg</texture>. -->
      <mimetype name="image/svg">
        <extension>.svg</extension>
        <description>Scalable Vector Graphics</description>
      </mimetype>
    </support>
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>@PLATFORM@</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/cinema-ONE/imagedecoder.svg</source>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
    <summary lang="en_GB">SVG file format decoder</summary>
    <description lang="en_GB">Scalable Vector Graphics (SVG) is a vector image format, rendered
sharp at any requested resolution instead of a single fixed pixel size.[CR][CR]Rendering is
provided by lunasvg (https://github.com/sammycage/lunasvg), MIT licensed.</description>
    <news>v1.1.0 (2026-08-29)
- Requires ImageDecoder API 3.1.0: Decode() now receives the output buffer size.
- Refuses to decode when the buffer cannot hold the rows it would write.

v1.0.0 (2026-08-21)
- Initial release.
- Decodes SVG at the size the file itself declares, capped at 4096px.
- Requires Kodi with the CImageDecoder hasAlpha fix (xbmc/xbmc#29068) for transparency.</news>
  </extension>
</addon>
